# Telegram Proxy Auto Deployer 环境变量模板
# 复制为 .env 后按实际环境填写。真实 .env 不要提交到仓库。

# =========================
# 必填配置
# =========================

# Telegram BotFather 生成的机器人 Token
BOT_TOKEN=replace_with_bot_token

# PostgreSQL 连接串
# 格式：postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://your_user:your_password@your_db_host:5432/your_db

# 管理员 Telegram 用户 ID（可用 @userinfobot 查询）
ADMIN_USER_ID=123456789

# =========================
# 常用配置
# =========================

# 默认 MTProxy 端口；新建时仍可在机器人里单独修改
PROXY_PORT=443

# 部署自检 TLS 域名；候选域名用英文逗号分隔
TLS_DOMAIN=cloudflare.com
TLS_DOMAIN_CANDIDATES=cloudflare.com,www.cloudflare.com,www.google.com

# MTProxy 固定广告 TAG；留空表示不启用
MTP_TAG=

# MTProxy Docker 镜像
MTP_IMAGE=ghcr.io/04by0302/mtproxy:master

# =========================
# 高级可选配置
# =========================

# 部署流程总超时（秒）
DEPLOY_TIMEOUT_SECONDS=300

# 单条远程命令超时（秒）
COMMAND_TIMEOUT_SECONDS=1800

# 用户会话在内存中的保留时间（秒）；进程重启会清空
SESSION_TTL_SECONDS=600

# 代理流量采样间隔（秒）
TRAFFIC_SAMPLE_INTERVAL_SECONDS=900

# 密码加密密钥（可选）
# 留空时从 BOT_TOKEN 派生；如需固定密钥，填写 44 字符 urlsafe base64 Fernet key
PASSWORD_ENCRYPTION_KEY=
